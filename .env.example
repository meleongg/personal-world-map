# Upstash Redis for time-limited public share links.
# Use distinct Stamped credentials; never commit real values.
KV_REST_API_URL=https://your-stamped-redis.upstash.io
KV_REST_API_TOKEN=replace-with-write-token

# Optional: a read-only token used to render shared maps and OG images.
KV_REST_API_READ_ONLY_TOKEN=replace-with-read-only-token

# The UPSTASH_REDIS_REST_* names are supported as fallbacks by app/lib/redis.ts.
# UPSTASH_REDIS_REST_URL=https://your-stamped-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-write-token
